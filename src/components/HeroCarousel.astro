---
import { getImage } from "astro:assets";
import SealMotif from "./SealMotif.astro";

const files = Object.values(
  import.meta.glob("../assets/hero/*.{jpg,jpeg,png,webp,avif}", { eager: true })
).map((m: any) => m.default);

const photos = await Promise.all(
  files.map((src) => getImage({ src, width: 720, height: 880, format: "webp" }))
);
const urls = photos.map((p) => p.src);
const BAR_COUNT = 7;
---
<div class="hero-media-photo">
  {urls.length > 0 ? (
    <>
      <img class="hero-photo-current" src={urls[0]} alt="" />
      {urls.length > 1 && (
        <div class="hero-bars" aria-hidden="true">
          {Array.from({ length: BAR_COUNT }).map(() => (
            <div class="hbar"><div class="hbar-photo"><img /></div></div>
          ))}
        </div>
      )}
      {urls.length > 1 && (
        <script define:vars={{ urls, BAR_COUNT }}>
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const root = document.currentScript.parentElement;
            const currentImg = root.querySelector(".hero-photo-current");
            const bars = Array.from(root.querySelectorAll(".hbar"));
            const photoWraps = Array.from(root.querySelectorAll(".hbar-photo"));
            const photoImgs = photoWraps.map((w) => w.querySelector("img"));

            const STEP_MS = 55;
            const REVEAL_MS = 650;
            const PHOTO_LAG_MS = 240;
            const PHOTO_FADE_MS = 420;
            const CYCLE_MS = 5000;
            const mid = (BAR_COUNT - 1) / 2;

            bars.forEach((bar, i) => {
              bar.style.transition = `transform ${REVEAL_MS}ms var(--ease)`;
              photoWraps[i].style.transition = `opacity ${PHOTO_FADE_MS}ms var(--ease)`;
              // cada franja contiene una copia de ancho completo de la foto, desplazada
              // a la izquierda lo justo para que, recortada por overflow:hidden, se vea
              // como una sola foto con object-fit:cover — igual que la capa de abajo.
              photoImgs[i].style.width = `${BAR_COUNT * 100}%`;
              photoImgs[i].style.left = `${-(i * 100)}%`;
            });

            let index = 0;
            const totalReveal = (BAR_COUNT - 1) * STEP_MS + PHOTO_LAG_MS + PHOTO_FADE_MS;

            function cycle() {
              const nextIndex = (index + 1) % urls.length;
              const nextUrl = urls[nextIndex];
              bars.forEach((bar, i) => {
                const d = Math.abs(i - mid) * STEP_MS;
                bar.style.transitionDelay = `${d}ms`;
                photoImgs[i].src = nextUrl;
                photoWraps[i].style.transitionDelay = `${d + PHOTO_LAG_MS}ms`;
              });
              requestAnimationFrame(() => requestAnimationFrame(() => {
                bars.forEach((bar, i) => {
                  bar.classList.add("show");
                  photoWraps[i].classList.add("show");
                });
              }));
              setTimeout(() => {
                currentImg.src = nextUrl;
                index = nextIndex;
                bars.forEach((bar, i) => {
                  bar.style.transition = "none";
                  photoWraps[i].style.transition = "none";
                  bar.classList.remove("show");
                  photoWraps[i].classList.remove("show");
                });
                void root.offsetWidth;
                bars.forEach((bar, i) => {
                  bar.style.transition = `transform ${REVEAL_MS}ms var(--ease)`;
                  photoWraps[i].style.transition = `opacity ${PHOTO_FADE_MS}ms var(--ease)`;
                });
              }, totalReveal);
            }

            setInterval(cycle, CYCLE_MS);
          }
        </script>
      )}
    </>
  ) : (
    <>
      <div class="ledger-lines" aria-hidden="true">
        <span style="width:72%"></span>
        <span style="width:88%"></span>
        <span style="width:60%"></span>
        <span style="width:80%"></span>
        <span style="width:46%"></span>
      </div>
      <div class="hero-seal"><SealMotif size={110} tone="accent" /></div>
    </>
  )}
</div>
