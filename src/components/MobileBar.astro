---
import Icon from "./Icon.astro";
import { waLink, contactLink } from "../data/site";

interface Props {
  service?: string;
}
const { service } = Astro.props;
const waMessage = service
  ? `Hola, quiero más información sobre ${service}.`
  : "Hola, quiero más información sobre sus servicios.";
---
<div class="mobile-bar">
  <a class="btn btn-outline" href={waLink(waMessage)}>
    <Icon name="wa" size={20} />WhatsApp
  </a>
  <a class="btn btn-accent" href={contactLink(service)}>Solicitar asesoría</a>
</div>
