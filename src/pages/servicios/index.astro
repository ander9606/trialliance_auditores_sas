---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { SERVICES } from "../../data/services";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: SERVICES.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/servicios/${s.slug}`, Astro.site).href,
    name: s.title,
  })),
};
---
<BaseLayout
  title="Servicios"
  description="Revisoría fiscal, auditoría externa, tributaria, de TI, SG-SST y outsourcing contable para empresas colombianas."
>
  <section class="section container" style="padding-top:48px">
    <div class="section-head">
      <h1 style="font-size:32px">Cumplir la norma y decidir con información confiable</h1>
    </div>
    <div class="svc-list">
      {SERVICES.map((s, i) => (
        <details class="svc-item" open={i === 0}>
          <summary aria-label={s.title}>
            <span class="svc-icon"><Icon name={s.icon} size={24} /></span>
            <span>
              <span class="svc-title">{s.title}</span><br />
              <span class="svc-desc">{s.desc}</span>
            </span>
            <span class="svc-sign"><Icon name="arrow" size={16} /></span>
          </summary>
          <div class="svc-body">
            {s.bullets.map((b) => (
              <div class="bullet"><span class="icon"><Icon name="check" size={16} /></span>{b}</div>
            ))}
            <a class="btn-link" href={`/servicios/${s.slug}`}>Ver detalle del servicio</a>
          </div>
        </details>
      ))}
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>
