---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---
<BaseLayout
  title="Página no encontrada"
  description="La página que busca no existe o cambió de dirección."
>
  <section class="section container" style="padding:96px 0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
    <h1 style="font-size:32px">No encontramos esta página</h1>
    <p style="font-size:16px;color:var(--text-soft);max-width:480px">
      Puede que la dirección cambió o que el enlace tenga un error. Pruebe desde aquí:
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
      <a class="btn btn-outline" href="/">Inicio</a>
      <a class="btn btn-outline" href="/servicios">Servicios</a>
      <a class="btn btn-accent" href="/contacto">Contacto<Icon name="arrow" size={18} /></a>
    </div>
  </section>
</BaseLayout>
