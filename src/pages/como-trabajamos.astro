---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { PROCESS_STEPS, contactLink } from "../data/site";
---
<BaseLayout
  title="Cómo trabajamos"
  description="Cinco etapas claras, de la primera reunión al informe: diagnóstico, propuesta, planeación, ejecución e informe."
>
  <section class="hero" style="padding:48px 0 72px">
    <div class="decor-ring" style="width:380px;height:380px;right:-180px;top:-180px"></div>
    <div class="container" style="display:block;max-width:var(--container)">
      <h1>Cinco etapas claras, de la primera reunión al informe</h1>
      <p class="lede" style="margin-top:12px">El mismo proceso se adapta a cada servicio, con el calendario y los entregables definidos desde la propuesta por escrito.</p>
    </div>
  </section>

  <section class="section container" style="padding-bottom:64px">
    <div class="steps">
      {PROCESS_STEPS.map((p) => (
        <div class="step">
          <span class="step-num">{p.n}</span>
          <div class="step-body">
            <span class="t">{p.t}</span>
            <span class="d">{p.d}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="decor-ring" style="width:380px;height:380px;left:-180px;top:-200px"></div>
    <div class="container">
      <h2 style="font-size:28px">¿Empezamos con el diagnóstico de su empresa?</h2>
      <a class="btn btn-accent" href={contactLink()}>Solicitar asesoría<Icon name="arrow" size={20} /></a>
    </div>
  </section>
</BaseLayout>
