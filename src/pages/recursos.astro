---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE, FAQ_GENERAL } from "../data/site";

// Preguntas con contenido confirmado (sin "[pendiente]"): las únicas que se publican como datos estructurados.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_GENERAL.filter((f) => !f.a.includes("[")).map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout
  title="Recursos y preguntas frecuentes"
  description="Preguntas frecuentes sobre revisoría fiscal y auditoría para empresas colombianas."
>
  <section class="hero" style="padding:48px 0 72px">
    <div class="decor-ring" style="width:380px;height:380px;right:-180px;top:-180px"></div>
    <div class="container" style="display:block;max-width:var(--container)">
      <h1>Preguntas frecuentes y material útil</h1>
      <p class="lede" style="margin-top:12px">¿Otra duda? Llámenos al <a href={`tel:+${SITE.phoneIntl}`} style="color:#fff;font-weight:700;text-decoration:underline">{SITE.phoneDisplay}</a>.</p>
    </div>
  </section>

  <section class="section container" style="padding-bottom:64px">
    <div class="faq-list">
      {FAQ_GENERAL.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            {f.q}
            <span class="faq-sign"><Icon name="arrow" size={16} /></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p style="margin-top:24px;font-size:15px;color:var(--text-soft)">
      [Pendiente: guías descargables y calendario de obligaciones, cuando TriAlliance confirme su contenido.]
    </p>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
