---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { SITE } from "../data/site";
import { getImage } from "astro:assets";
import ogSource from "../assets/hero/young-business-people-modern-office-working-solution-having-meeting-about-new-project.jpg";

interface Props {
  title: string;
  description: string;
  service?: string;
  noindex?: boolean;
}
const { title, description, service, noindex } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | TriAlliance Auditores`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, format: "jpg" });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;

// Esquema de empresa para buscadores. Dirección queda fuera hasta que TriAlliance la confirme (ver data/site.ts).
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  name: SITE.name,
  url: Astro.site?.href,
  image: ogImageUrl,
  telephone: `+${SITE.phoneIntl}`,
  email: SITE.email,
  areaServed: "CO",
  ...(SITE.address.startsWith("[")
    ? {}
    : { address: { "@type": "PostalAddress", streetAddress: SITE.address, addressCountry: "CO" } }),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0B2160" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar service={service} />
    <a href="#top" class="back-to-top" aria-label="Volver arriba">↑</a>
    <script>
      const backToTop = document.querySelector(".back-to-top");
      addEventListener(
        "scroll",
        () => backToTop?.classList.toggle("is-visible", scrollY > innerHeight),
        { passive: true },
      );
    </script>
  </body>
</html>
